{# Sơ đồ thế bấm hợp âm guitar. frets: 6 số từ dây 6 → dây 1, -1 = không gảy, 0 = dây buông #}
{% macro chord_svg(frets) %}
<svg class="chord-svg" viewBox="0 0 70 84" aria-hidden="true">
  <rect x="10" y="14" width="50" height="3" fill="currentColor"/>
  {% for i in range(6) %}<line x1="{{ 10 + i * 10 }}" y1="16" x2="{{ 10 + i * 10 }}" y2="80" stroke="currentColor" stroke-width="{{ 1.6 - i * 0.18 }}"/>{% endfor %}
  {% for f in range(1, 5) %}<line x1="10" y1="{{ 16 + f * 16 }}" x2="60" y2="{{ 16 + f * 16 }}" stroke="currentColor" stroke-width=".7" opacity=".55"/>{% endfor %}
  {% for f in frets %}
    {% if f == -1 %}<text x="{{ 10 + loop.index0 * 10 }}" y="10" text-anchor="middle" font-size="9" fill="currentColor">×</text>
    {% elif f == 0 %}<circle cx="{{ 10 + loop.index0 * 10 }}" cy="7" r="2.6" fill="none" stroke="currentColor" stroke-width="1"/>
    {% else %}<circle class="dot" cx="{{ 10 + loop.index0 * 10 }}" cy="{{ 8 + f * 16 }}" r="4.2"/>{% endif %}
  {% endfor %}
</svg>
{% endmacro %}

{# Danh sách 6 bài tập, mỗi hàng là một dây đàn #}
{% macro string_rows(projects, detailed) %}
<ol class="rows{% if detailed %} rows-detailed{% endif %}">
  {% for p in projects %}
  <li>
    <a class="row" href="bai-{{ p.id }}.html">
      <span class="row-num">{{ p.id }}</span>
      <span class="row-main">
        <span class="row-title">{{ p.title }}</span>
        <span class="row-chapter">{{ p.chapter }}</span>
        {% if detailed %}<span class="row-short">{{ p.short }}</span>{% endif %}
      </span>
      <span class="row-string">Dây {{ p.string }}, nốt {{ p.note }}</span>
      <span class="string string-row" data-string="{{ p.string }}" data-hz="{{ open_hz[p.string] }}" aria-hidden="true"></span>
    </a>
  </li>
  {% endfor %}
</ol>
{% endmacro %}

{# Ảnh minh chứng mở được trong khung xem lớn #}
{% macro shot(file, cap, group, wide=false) %}
<figure class="shot{% if wide %} shot-wide{% endif %}">
  <a href="assets/img/{{ file }}" data-zoom="{{ group }}" data-cap="{{ cap }}">{{ img(file, cap) }}</a>
  <figcaption>{{ cap }}</figcaption>
</figure>
{% endmacro %}
