{% extends "_base.html.j2" %}
{% from "_macros.html.j2" import string_rows %}
{% block title %}Bài tập — {{ name }}{% endblock %}
{% block main %}
<header class="phead">
  <div class="wrap">
    <p class="phead-kicker">{{ subject }}</p>
    <h1 class="phead-title">6 bài tập</h1>
    <p class="phead-lead">Sáu chương của học phần, mỗi chương một bài. Rê chuột qua từng dây để nghe nốt của dây đó, bấm để mở bài.</p>
  </div>
</header>
<section class="six six-page">
  <div class="wrap">
    {{ string_rows(projects, true) }}
  </div>
</section>
{% endblock %}
